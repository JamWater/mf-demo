  "scripts": {
    "prepare": "husky",
    "kill:port": "node scripts/kill-port.js",
    "css:build": "npx @tailwindcss/cli -i ./src/index.css -o ./src/index.generated.css && sec…",
    "css:watch": "npx @tailwindcss/cli -i ./src/index.css -o ./src/index.generated.css --watch",
    "start": "npm run kill:port && rsbuild dev",
    "start:custom": "npm run start -- --env-mode $ENV_MODE",
    "start:webserver": "env-cmd -f .env.e2e node server.js",
    "start:webserver_data": "env-cmd -f .env.e2e node server_data.js",
    "debug": "FEDERATION_DEBUG=true npm run start -- --env-mode dev",
    "preview": "rsbuild preview",
    "dev": "npm run start:custom",
    "dev:e2e": "env-cmd -f .env.e2e npm run start:custom",
    "dev:sg": "npm run dev sg-digibank-shared-dev",
    "dev:hk": "npm run dev hk-digibank-shared-dev",
    "dev:id": "npm run dev id-digibank-mb-dev",
    "dev:cardplus": "npm run dev tw-cardplus-mb-dev",
    "dev:tw": "npm run dev tw-digibank-shared-dev",
    "dev:twibuat": "BUILD_CHANNEL=IB npm run dev tw-digibank-shared-webuat",
    "dev:twmbuat": "BUILD_CHANNEL=MB npm run dev tw-digibank-shared-webuat",
    "dev:in": "npm run dev in-digibank-shared-dev",
    "dev-windows:sg": "cross-env ENV_MODE=sg-digibank-shared-dev npm run dev",
    "dev-windows:hk": "cross-env ENV_MODE=hk-digibank-shared-dev npm run dev",
    "dev-windows:id": "rsbuild dev --open --env-mode id-digibank-mb-dev",
    "dev-windows:tw": "rsbuild dev --open --env-mode tw-cardplus-mb-dev",
    "uat": "npm run start -- --env-mode webuat",
    "uat:sg": "npm run dev sg-digibank-shared-webuat",
    "uat:hk": "npm run dev hk-digibank-shared-webuat",
    "uat:id": "npm run dev id-digibank-mb-webuat",
    "load": "npm run start -- --env-mode webload",
    "pat": "npm run start -- --env-mode webpat",
    "pilot": "npm run start -- --env-mode webpilot",
    "pilot:sg": "npm run dev sg-digibank-shared-webpilot",
    "pilot:id": "npm run dev id-digibank-mb-webpilot",
    "prod": "npm run start -- --env-mode webproduction",
    "prod:sg": "npm run dev sg-digibank-shared-webproduction",
    "prod:id": "npm run dev id-digibank-mb-webproduction",
    "build": "node scripts/build.mjs $ENV",
    "build:custom": "npm run build",
